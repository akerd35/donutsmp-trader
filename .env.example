# Minecraft / DonutSMP Bağlantı Ayarları
MC_HOST=donutsmp.net
MC_PORT=25565
MC_VERSION=1.20.4
MC_USERNAME=your_email_or_username
MC_AUTH=microsoft # 'microsoft' veya 'offline'

# Arbitraj ve Ticaret Ayarları
MIN_PROFIT_MARGIN=0.20       # Minimum %20 kâr marjı
MIN_PROFIT_AMOUNT=50000      # Minimum 50k$ kâr
MAX_SPEND_PER_ITEM=5000000   # Tek eşyaya verilecek maksimum bakiye
PRICE_HISTORY_SAMPLE_SIZE=20 # Fiyat medyanı için örneklem boyutu
SIMULATION_MODE=true         # true ise satın almaz, sadece karlı eşyaları tespit edip loglar

# Güvenlik ve Anti-Detection
CLICK_DELAY_MIN=250          # Minimum tıklama gecikmesi (ms)
CLICK_DELAY_MAX=600          # Maksimum tıklama gecikmesi (ms)
AH_REFRESH_INTERVAL=1500     # AH yenileme sıklığı (ms)
